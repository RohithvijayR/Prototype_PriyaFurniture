rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: default-deny everything unless explicitly allowed below.
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =========================================================================
    // Locked ERP Collections & Retired Legacy Collections (Explicit Default-Deny)
    // =========================================================================
    // Business-sensitive collections remain strictly locked until dedicated
    // server-controlled ERP workflows are approved and implemented.

    match /products/{productId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read, write: if false;
    }

    // Retired legacy Phase 2.1 intake collection: locked default-deny to preserve
    // any historical records intact without allowing new writes or client reads.
    match /quoteRequests/{quoteId} {
      allow read, write: if false;
    }

    // =========================================================================
    // Phase 2.3 User Account Profiles (`/users/{userId}`)
    // =========================================================================
    // - Owner-only get, create, and allowlisted profile update.
    // - Zero list or delete access (protects PII and ERP audit history).
    // - Role is strictly forced to 'customer' on create and immutable on update.
    // - Account status is strictly forced to 'active' on create and immutable on update.
    // - Suspended accounts cannot mutate their profile.

    function isValidOptionalAddress(addr) {
      return addr == null || (
        addr is map
        && addr.keys().hasAll(['line1', 'city', 'state', 'postalCode', 'country'])
        && addr.keys().hasOnly(['line1', 'line2', 'city', 'state', 'postalCode', 'country'])
        && addr.line1 is string
        && addr.line1.size() >= 1
        && addr.line1.size() <= 200
        && (!('line2' in addr) || (addr.line2 is string && addr.line2.size() <= 200))
        && addr.city is string
        && addr.city.size() >= 1
        && addr.city.size() <= 100
        && addr.state is string
        && addr.state.size() >= 1
        && addr.state.size() <= 100
        && addr.postalCode is string
        && addr.postalCode.size() >= 3
        && addr.postalCode.size() <= 20
        && addr.country is string
        && addr.country.size() >= 2
        && addr.country.size() <= 80
      );
    }

    function isValidUserProfile(data, userId) {
      return data is map
        && data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'phoneNumber',
          'accountType',
          'organizationName',
          'billingAddress',
          'shippingAddress',
          'role',
          'accountStatus',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'phoneNumber',
          'accountType',
          'organizationName',
          'billingAddress',
          'shippingAddress',
          'role',
          'accountStatus',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 254
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.phoneNumber is string
        && data.phoneNumber.size() <= 32
        && (data.phoneNumber.size() == 0 || data.phoneNumber.matches('^[+0-9()\\s.\\-]{7,32}$'))
        && data.accountType is string
        && data.accountType.size() >= 1
        && data.accountType.size() <= 24
        && data.accountType in ['individual', 'business', 'partner', 'internal']
        && data.organizationName is string
        && data.organizationName.size() <= 160
        && isValidOptionalAddress(data.billingAddress)
        && isValidOptionalAddress(data.shippingAddress)
        && data.role is string
        && data.role.size() >= 1
        && data.role.size() <= 24
        && data.role in ['customer', 'partner', 'sales', 'staff', 'admin']
        && data.accountStatus is string
        && data.accountStatus.size() >= 1
        && data.accountStatus.size() <= 32
        && data.accountStatus in ['active', 'pending_verification', 'suspended', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function matchesAuthEmail(email) {
      return request.auth.token.email is string
        && email.lower() == request.auth.token.email.lower();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && matchesAuthEmail(incoming().email)
        && incoming().role == 'customer'
        && incoming().accountStatus == 'active'
        && incoming().accountType in ['individual', 'business']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && existing().accountStatus != 'suspended'
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'phoneNumber',
          'accountType',
          'organizationName',
          'billingAddress',
          'shippingAddress',
          'updatedAt'
        ])
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().accountStatus == existing().accountStatus
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().accountType in ['individual', 'business']
          || incoming().accountType == existing().accountType
        );
      allow delete: if false;
    }

    // =========================================================================
    // Phase 2.4 Authoritative Quotation Requests (`/quotationRequests/{id}`)
    // =========================================================================
    // - Public visitors create with `userId == null`; signed-in customers create
    //   with `userId == request.auth.uid`.
    // - Status is strictly locked to `'submitted'` on create.
    // - Signed-in customers may only `get` or `list` documents where
    //   `resource.data.userId == request.auth.uid`.
    // - Zero client `update` or `delete` permissions (immutable history & status).
    // - Internal staff notes are physically isolated in locked subcollection
    //   `/quotationRequests/{quotationRequestId}/internalNotes/{noteId}`.

    // Exact 11-key allowlist: item.size() == 11 combined with explicit evaluation of
    // all 11 distinct keys rejects any missing or extra shadow fields without incurring
    // quadratic keys().hasOnly() expression overhead on multi-item submissions.
    function isValidQuotationProductSnapshot(item) {
      return item is map
        && item.size() == 11
        && item.productId is string && item.productId.size() >= 1 && item.productId.size() <= 100
        && item.categoryId in ['pedicure-manicure', 'barber-chairs', 'hairwash-stations', 'facial-beds', 'custom']
        && item.categoryName is string && item.categoryName.size() >= 1 && item.categoryName.size() <= 120
        && item.productCode is string && item.productCode.size() >= 1 && item.productCode.size() <= 32
        && item.productName is string && item.productName.size() >= 1 && item.productName.size() <= 180
        && item.quantity is int && item.quantity >= 1 && item.quantity <= 10000
        && item.customizationDetails is string && item.customizationDetails.size() <= 500
        && item.dimensions is string && item.dimensions.size() <= 200
        && item.materialFinishPreferences is string && item.materialFinishPreferences.size() <= 200
        && (item.indicativeBaseRateInr == null || (item.indicativeBaseRateInr is int && item.indicativeBaseRateInr >= 0 && item.indicativeBaseRateInr <= 10000000))
        && (item.imagePath == null || (item.imagePath is string && item.imagePath.size() >= 1 && item.imagePath.size() <= 300));
    }

    // Pillar 5 Total Array Guarding: bounds list length (1..10) and validates
    // first, second (when present), and last snapshots — staying well within
    // Firestore's 1,000-expression and 10-regex-call limits (7 total regex calls max).
    function areQuotationProductsValid(items) {
      return items is list
        && items.size() >= 1
        && items.size() <= 10
        && isValidQuotationProductSnapshot(items[0])
        && items[0].productId.matches('^[a-z0-9\\-]+$')
        && items[0].productCode.matches('^[A-Z0-9\\s\\-]+$')
        && (items[0].imagePath == null || items[0].imagePath.matches('^/assets/catalogue/[a-z0-9/_.\\-]+$'))
        && (items.size() <= 1 || isValidQuotationProductSnapshot(items[1]))
        && (items.size() <= 2 || isValidQuotationProductSnapshot(items[items.size() - 1]));
    }

    // Exact 20-key allowlist: data.size() == 20 combined with explicit validation
    // of all 20 distinct keys rejects any missing or extra shadow fields (such as
    // internalNotes or admin flags) while staying well below Firestore's 1,000-expression limit.
    function isValidQuotationRequest(data, quotationRequestId) {
      return data is map
        && data.size() == 20
        && data.id == quotationRequestId
        && data.referenceNumber is string
        && data.referenceNumber.size() >= 12
        && data.referenceNumber.size() <= 32
        && data.referenceNumber.matches('^PF-RFQ-[0-9]{4}-[A-Z0-9]{4,8}$')
        && (
          (!isSignedIn() && data.userId == null)
          || (isSignedIn() && data.userId == request.auth.uid)
        )
        && data.source == 'web_catalogue'
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.organizationName is string && data.organizationName.size() >= 1 && data.organizationName.size() <= 160
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 254 && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 32 && data.phone.matches('^[+0-9()\\s.\\-]{7,32}$')
        && areQuotationProductsValid(data.requestedProducts)
        && data.itemCount == data.requestedProducts.size()
        && data.totalQuantity is int && data.totalQuantity >= data.requestedProducts.size() && data.totalQuantity <= 100000
        && data.deliveryLocation is string && data.deliveryLocation.size() >= 2 && data.deliveryLocation.size() <= 200
        && data.additionalRequirements is string && data.additionalRequirements.size() <= 2000
        && data.status == 'submitted'
        && data.revisionNumber == 1
        && data.parentQuotationRequestId == null
        && data.activeQuotationVersionId == null
        && data.convertedOrderId == null
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /quotationRequests/{quotationRequestId} {
      allow create: if isValidId(quotationRequestId)
        && isValidQuotationRequest(incoming(), quotationRequestId);
      allow get: if isValidId(quotationRequestId)
        && isSignedIn()
        && existing().userId == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;

      // Physically isolated internal staff review notes: strictly default-deny for all client SDK calls.
      match /internalNotes/{noteId} {
        allow read, write: if false;
      }
    }
  }
}
